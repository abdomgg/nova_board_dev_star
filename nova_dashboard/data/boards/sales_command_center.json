        "x": 0,
        "y": 15,
        "w": 6,
        "h": 9
      },
      "icon": "fa-users",
      "model_name": "sale.order",
      "chart_palette": "vivid",
      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "sum",
      "measure_names": "amount_total",
      "group_field_name": "user_id",
      "record_limit": 10,
      "sort_dir": "desc",
      "use_currency": true,
      "show_values": true
    },
    {
      "name": "Top Customers",
      "item_type": "leaderboard",
      "sequence": 8,
      "pos": {
        "x": 6,
        "y": 15,
        "w": 6,
        "h": 9
      },
      "icon": "fa-trophy",
