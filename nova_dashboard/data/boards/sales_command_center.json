      "chart_palette": "ocean",
      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "sum",
      "measure_names": "amount_total",
      "group_field_name": "team_id",
      "record_limit": 6,
      "sort_dir": "desc",
      "use_currency": true,
      "show_legend": true
