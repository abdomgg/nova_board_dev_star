      "pos": {
        "x": 0,
        "y": 24,
        "w": 4,
        "h": 9
      },
      "icon": "fa-filter",
      "model_name": "sale.order",
      "date_field_name": "date_order",
      "agg": "count",
      "group_field_name": "state"
    },
    {
      "name": "Order Heat \u2014 Month \u00d7 Team",
      "item_type": "heatmap",
      "sequence": 10,
      "pos": {
        "x": 4,
        "y": 24,
        "w": 8,
        "h": 9
      },
      "icon": "fa-th",
      "model_name": "sale.order",
      "date_field_name": "date_order",
      "domain": "[('state','=','sale')]",
      "agg": "count",
      "group_field_name": "date_order",
      "group_granularity": "month",
      "subgroup_field_name": "team_id"
    },
    {
      "name": "Latest Orders",
      "item_type": "list",
      "sequence": 11,
      "pos": {
        "x": 0,
        "y": 33,
        "w": 12,
        "h": 9
      },
      "icon": "fa-table",
      "model_name": "sale.order",
      "date_field_name": "date_order",
      "list_field_names": "name,partner_id,date_order,amount_total,state",
      "record_limit": 8
    }
