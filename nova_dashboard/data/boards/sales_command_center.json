      "fill_gaps": true,
      "enable_forecast": true,
      "forecast_periods": 3,
      "detect_anomalies": true,
      "compare_previous_item": true,
      "use_currency": true,
      "show_legend": true
    },
    {
      "name": "Revenue by Team",
