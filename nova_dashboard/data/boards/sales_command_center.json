      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "sum",
      "measure_names": "amount_total",
      "group_field_name": "partner_id",
      "record_limit": 8,
      "sort_dir": "desc",
      "use_currency": true
    },
    {
      "name": "Order Status Flow",
      "item_type": "funnel",
