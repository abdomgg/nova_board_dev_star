{
  "nova_version": 1,
  "requires": [
    "sale.order"
  ],
  "name": "Sales Command Center",
  "description": "Revenue, momentum and team performance \u2014 live",
  "theme": "aurora",
  "accent_color": "#7C6CFF",
  "date_preset": "this_year",
  "items": [
    {
      "name": "Revenue",
      "item_type": "kpi",
      "sequence": 1,
      "pos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-line-chart",
      "color": "#7C6CFF",
      "model_name": "sale.order",
      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "sum",
      "measure_names": "amount_total",
      "use_currency": true,
      "compare_previous_item": true,
      "enable_forecast": true
    },
    {
      "name": "Orders",
      "item_type": "kpi",
      "sequence": 2,
      "pos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-shopping-cart",
      "color": "#22C7A9",
      "model_name": "sale.order",
      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "count",
      "compare_previous_item": true
    },
    {
      "name": "Avg Order Value",
      "item_type": "tile",
      "sequence": 3,
      "pos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-tags",
      "color": "#FF7A9E",
      "model_name": "sale.order",
      "domain": "[('state','=','sale')]",
      "date_field_name": "date_order",
      "agg": "avg",
      "measure_names": "amount_total",
      "use_currency": true,
      "compare_previous_item": true
    },
    {
      "name": "Open Quotations",
      "item_type": "kpi",
      "sequence": 4,
      "pos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-file-text-o",
      "color": "#FFB35C",
      "model_name": "sale.order",
      "domain": "[('state','in',('draft','sent'))]",
      "date_field_name": "date_order",
      "agg": "count"
    },
    {
      "name": "Revenue Momentum",
      "item_type": "line",
      "sequence": 5,
      "pos": {
        "x": 0,
        "y": 5,
        "w": 8,
        "h": 10
      },
      "icon": "fa-line-chart",
