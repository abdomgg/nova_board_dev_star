{
  "nova_version": 1,
  "requires": [
    "crm.lead"
  ],
  "name": "CRM Pipeline Intelligence",
  "description": "Pipeline health, conversion and team firepower",
  "theme": "nebula",
  "accent_color": "#B06CFF",
  "date_preset": "this_year",
  "items": [
    {
      "name": "Pipeline Value",
      "item_type": "kpi",
      "sequence": 1,
      "pos": {
        "x": 0,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-money",
      "color": "#B06CFF",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity')]",
      "date_field_name": "create_date",
      "agg": "sum",
      "measure_names": "expected_revenue",
      "use_currency": true,
      "compare_previous_item": true,
      "enable_forecast": true
    },
    {
      "name": "Open Opportunities",
      "item_type": "kpi",
      "sequence": 2,
      "pos": {
        "x": 3,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-crosshairs",
      "color": "#4CC2FF",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity'),('probability','<',100)]",
      "date_field_name": "create_date",
      "agg": "count",
      "compare_previous_item": true
    },
    {
      "name": "Won Deals",
      "item_type": "kpi",
      "sequence": 3,
      "pos": {
        "x": 6,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-trophy",
      "color": "#22C7A9",
      "model_name": "crm.lead",
      "domain": "[('probability','=',100)]",
      "date_field_name": "create_date",
      "agg": "count",
      "compare_previous_item": true
    },
    {
      "name": "New Leads (30d)",
      "item_type": "kpi",
      "sequence": 4,
      "pos": {
        "x": 9,
        "y": 0,
        "w": 3,
        "h": 5
      },
      "icon": "fa-user-plus",
      "color": "#FFB35C",
      "model_name": "crm.lead",
      "date_field_name": "create_date",
      "date_preset_item": "last_30",
      "agg": "count"
    },
    {
      "name": "Pipeline by Stage",
      "item_type": "funnel",
      "sequence": 5,
      "pos": {
        "x": 0,
        "y": 5,
        "w": 5,
        "h": 10
      },
      "icon": "fa-filter",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity')]",
      "date_field_name": "create_date",
      "agg": "sum",
      "measure_names": "expected_revenue",
      "group_field_name": "stage_id",
      "use_currency": true
    },
    {
      "name": "Expected Revenue Trend",
      "item_type": "line",
      "sequence": 6,
      "pos": {
        "x": 5,
        "y": 5,
        "w": 7,
        "h": 10
      },
      "icon": "fa-line-chart",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity')]",
      "date_field_name": "create_date",
      "agg": "sum",
      "measure_names": "expected_revenue",
      "group_field_name": "create_date",
      "group_granularity": "month",
      "fill_gaps": true,
      "enable_forecast": true,
      "forecast_periods": 3,
      "detect_anomalies": true,
      "use_currency": true,
      "show_legend": true
    },
    {
      "name": "Stage \u00d7 Owner Heat",
      "item_type": "heatmap",
      "sequence": 7,
      "pos": {
        "x": 0,
        "y": 15,
        "w": 7,
        "h": 9
      },
      "icon": "fa-th",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity')]",
      "date_field_name": "create_date",
      "agg": "count",
      "group_field_name": "stage_id",
      "subgroup_field_name": "user_id"
    },
    {
      "name": "Top Performers",
      "item_type": "leaderboard",
      "sequence": 8,
      "pos": {
        "x": 7,
        "y": 15,
        "w": 5,
        "h": 9
      },
      "icon": "fa-star",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity')]",
      "date_field_name": "create_date",
      "agg": "sum",
      "measure_names": "expected_revenue",
      "group_field_name": "user_id",
      "record_limit": 8,
      "sort_dir": "desc",
      "use_currency": true
    },
    {
      "name": "Lead Sources",
      "item_type": "pie",
      "sequence": 9,
      "pos": {
        "x": 0,
        "y": 24,
        "w": 4,
        "h": 9
      },
      "icon": "fa-pie-chart",
      "model_name": "crm.lead",
      "chart_palette": "candy",
      "date_field_name": "create_date",
      "agg": "count",
      "group_field_name": "source_id",
      "record_limit": 7,
      "sort_dir": "desc",
      "show_legend": true
    },
    {
      "name": "Hot Opportunities",
      "item_type": "list",
      "sequence": 10,
      "pos": {
        "x": 4,
        "y": 24,
        "w": 8,
        "h": 9
      },
      "icon": "fa-fire",
      "model_name": "crm.lead",
      "domain": "[('type','=','opportunity'),('probability','>=',40)]",
      "date_field_name": "create_date",
      "list_field_names": "name,partner_id,expected_revenue,probability,user_id",
      "record_limit": 8
    }
  ]
}