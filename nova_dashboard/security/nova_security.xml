<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_nova" model="ir.module.category">
        <field name="name">NovaBoard</field>
        <field name="sequence">25</field>
    </record>

    <record id="group_nova_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_nova"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="group_nova_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_nova"/>
        <field name="implied_ids" eval="[(4, ref('group_nova_user'))]"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <record id="rule_nova_dashboard_user" model="ir.rule">
        <field name="name">NovaBoard: user sees allowed dashboards</field>
        <field name="model_id" ref="model_nova_dashboard"/>
        <field name="groups" eval="[(4, ref('group_nova_user'))]"/>
        <field name="domain_force">['|', '|', ('access_group_ids', '=', False), ('access_group_ids', 'in', user.groups_id.ids), ('create_uid', '=', user.id)]</field>
    </record>

    <record id="rule_nova_dashboard_manager" model="ir.rule">
        <field name="name">NovaBoard: manager sees all</field>
        <field name="model_id" ref="model_nova_dashboard"/>
        <field name="groups" eval="[(4, ref('group_nova_manager'))]"/>
        <field name="domain_force">[(1, '=', 1)]</field>
    </record>

    <record id="rule_nova_dashboard_company" model="ir.rule">
        <field name="name">NovaBoard: multi-company</field>
        <field name="model_id" ref="model_nova_dashboard"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
