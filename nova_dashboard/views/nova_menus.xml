<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_nova_open" model="ir.actions.client">
        <field name="name">Dashboards</field>
        <field name="tag">nova_dashboard_action</field>
    </record>

    <menuitem id="menu_nova_root" name="NovaBoard" sequence="6"
              groups="nova_dashboard.group_nova_user"
              web_icon="nova_dashboard,static/description/icon.png"/>

    <!-- Collector: every dashboard lives here; opening it lands on the first board -->
    <menuitem id="menu_nova_boards" name="Dashboards" parent="menu_nova_root"
              action="action_nova_open" sequence="1"
              groups="nova_dashboard.group_nova_user"/>

    <menuitem id="menu_nova_config" name="Configuration" parent="menu_nova_root"
              sequence="900" groups="nova_dashboard.group_nova_manager"/>
    <menuitem id="menu_nova_dashboards" name="Manage Dashboards" parent="menu_nova_config"
              action="action_nova_dashboards" sequence="10"/>
    <menuitem id="menu_nova_showcase" name="Generate Showcase" parent="menu_nova_config"
              action="action_nova_showcase" sequence="20"/>

    <!-- On install & every upgrade: pull existing board menus under the collector -->
    <function model="nova.dashboard" name="_relocate_menus"/>
</odoo>
